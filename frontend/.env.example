# Copy to frontend/.env for local development:   cp .env.example .env
#
# Local dev: the backend started with uvicorn on port 8000.
VITE_API_URL=http://127.0.0.1:8000

# Production (Vercel): do not commit a production URL here. In Vercel go to
# Project Settings > Environment Variables, add VITE_API_URL with your Render
# URL (e.g. https://your-service.onrender.com), then REDEPLOY - Vite bakes the
# value in at build time, so changing it requires a new build. A production
# build with no VITE_API_URL fails with an explicit error instead of guessing.
