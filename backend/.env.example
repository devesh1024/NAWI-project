# Copy to backend/.env for local development:   cp backend/.env.example backend/.env
# Never commit .env (it is in .gitignore). On Render, set these same variables
# in the service's Environment tab instead of using a file.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. The "+psycopg2" driver prefix is REQUIRED: a bare
# "postgresql://" fails on this SQLAlchemy version.
# Supabase: copy the connection string from Project Settings > Database, then
# make sure it starts with postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# Local dev/tests only alternative (no Postgres needed):
# DATABASE_URL=sqlite:///./nawi_dev.db

# --- Auth -------------------------------------------------------------------
# Secret used to sign login tokens. Generate a real one and keep it private:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# --- CORS (deployed frontend) -----------------------------------------------
# Comma-separated exact origins allowed to call this API. Use your real Vercel
# URL, with no trailing slash. http://localhost:5173 is always allowed.
CORS_ORIGINS=https://your-app.vercel.app
# Optional: regex for Vercel preview deployments (URL changes per branch).
# CORS_ORIGIN_REGEX=https://your-app.*\.vercel\.app
